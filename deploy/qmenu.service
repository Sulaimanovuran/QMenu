# systemd unit для QMenu backend.
# Установка:
#   sudo cp deploy/qmenu.service /etc/systemd/system/qmenu.service
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now qmenu
# Логи: journalctl -u qmenu -f

[Unit]
Description=QMenu Backend (FastAPI/uvicorn)
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=simple
User=qmenu
Group=qmenu
WorkingDirectory=/opt/qmenu
# .env лежит в WorkingDirectory — python-decouple читает его сам,
# EnvironmentFile не обязателен, но продублирован для systemd-переменных
EnvironmentFile=-/opt/qmenu/.env
ExecStart=/opt/qmenu/venv/bin/uvicorn main:app --host 127.0.0.1 --port 8000 --workers 2 --proxy-headers --forwarded-allow-ips="127.0.0.1"
Restart=always
RestartSec=3

# ── Защита данных ─────────────────────────────────────────────────────────────
# Каталог картинок (UPLOAD_DIR из .env) должен быть доступен на запись
ReadWritePaths=/var/lib/qmenu/uploads
# Безопасность процесса
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=multi-user.target
