# Скопируйте в .env и заполните. Читается через python-decouple (config()).

# ── Обязательно на сервере ────────────────────────────────────────────────────
# Секрет подписи JWT. Сгенерировать: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-32+byte-secret

# SQLite (dev, значение по умолчанию):
# DB_URL=sqlite://db.sqlite3
# PostgreSQL (VPS):
DB_URL=asyncpg://qmenu:qmenu_password@127.0.0.1:5432/qmenu

# Базовый URL guest-фронтенда — из него собираются QR-ссылки столов
# (public_url = PUBLIC_BASE_URL/t/<qr_token>).
# Пока фронт тестируется с локалки:
PUBLIC_BASE_URL=http://localhost:3000

# Origin'ы фронтенда для CORS, через запятую (фронт с локалки):
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ── Файлы ─────────────────────────────────────────────────────────────────────
# Каталог загруженных картинок — ВНЕ репозитория, чтобы переживал деплой.
# Пусто/не задан = <корень проекта>/uploads (подходит для dev)
UPLOAD_DIR=/var/lib/qmenu/uploads
# Фронт работает с другого origin -> ссылки на картинки должны быть абсолютными.
# Укажите адрес API (nginx): http://<IP-VPS>  (с доменом: https://api.qmenu.kg)
MEDIA_BASE_URL=http://<IP-VPS>
# Максимальный размер картинки в байтах (по умолчанию 5 МБ)
MAX_UPLOAD_BYTES=5242880

# ── Токены ────────────────────────────────────────────────────────────────────
ACCESS_TOKEN_TTL_MINUTES=30
REFRESH_TOKEN_TTL_DAYS=30
